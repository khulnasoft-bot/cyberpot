{
    "dashboard": {
        "title": "CyberPot - Resource Usage",
        "tags": [
            "cyberpot",
            "resources"
        ],
        "timezone": "browser",
        "panels": [
            {
                "title": "Memory Usage by Container",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "container_memory_usage_bytes{name=~\"elasticsearch|logstash|kibana|cyberpot.*\"}",
                        "legendFormat": "{{name}}"
                    }
                ]
            },
            {
                "title": "CPU Usage by Container",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 0
                },
                "targets": [
                    {
                        "expr": "rate(container_cpu_usage_seconds_total{name=~\"elasticsearch|logstash|kibana|cyberpot.*\"}[5m]) * 100",
                        "legendFormat": "{{name}}"
                    }
                ]
            },
            {
                "title": "Disk Usage",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 0,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "(node_filesystem_size_bytes - node_filesystem_avail_bytes) / node_filesystem_size_bytes * 100",
                        "legendFormat": "{{mountpoint}}"
                    }
                ]
            },
            {
                "title": "Network I/O",
                "type": "graph",
                "gridPos": {
                    "h": 8,
                    "w": 12,
                    "x": 12,
                    "y": 8
                },
                "targets": [
                    {
                        "expr": "rate(container_network_receive_bytes_total[5m])",
                        "legendFormat": "RX {{name}}"
                    },
                    {
                        "expr": "rate(container_network_transmit_bytes_total[5m])",
                        "legendFormat": "TX {{name}}"
                    }
                ]
            }
        ],
        "refresh": "10s",
        "time": {
            "from": "now-1h",
            "to": "now"
        }
    }
}