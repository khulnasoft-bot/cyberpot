# CyberPot Resource Optimization Configuration
# This file contains resource optimization settings for different deployment scenarios

###################################################################################
# Resource Mode Configuration
###################################################################################

# CYBERPOT_RESOURCE_MODE
#  LOW: Optimized for resource-constrained environments (Raspberry Pi, small VMs)
#       - Elasticsearch heap: 1GB
#       - Logstash heap: 512MB
#       - Reduced polling frequency
#       - Aggressive log cleanup
#  STANDARD: Balanced configuration (default, recommended for most deployments)
#       - Elasticsearch heap: 2GB
#       - Logstash heap: 1GB
#       - Standard polling frequency
#       - 30-day log retention
#  HIGH: High-performance configuration for production environments
#       - Elasticsearch heap: 4GB
#       - Logstash heap: 2GB
#       - Frequent polling
#       - Extended log retention
CYBERPOT_RESOURCE_MODE=STANDARD

###################################################################################
# Memory Configuration
###################################################################################

# Elasticsearch Memory Settings (Java heap size)
# LOW mode: 1024m, STANDARD mode: 2048m, HIGH mode: 4096m
CYBERPOT_ES_HEAP_SIZE_LOW=1024m
CYBERPOT_ES_HEAP_SIZE_STANDARD=2048m
CYBERPOT_ES_HEAP_SIZE_HIGH=4096m

# Logstash Memory Settings (Java heap size)
# LOW mode: 512m, STANDARD mode: 1024m, HIGH mode: 2048m
CYBERPOT_LS_HEAP_SIZE_LOW=512m
CYBERPOT_LS_HEAP_SIZE_STANDARD=1024m
CYBERPOT_LS_HEAP_SIZE_HIGH=2048m

# Kibana Memory Limit
CYBERPOT_KIBANA_MEM_LIMIT_LOW=512m
CYBERPOT_KIBANA_MEM_LIMIT_STANDARD=1g
CYBERPOT_KIBANA_MEM_LIMIT_HIGH=2g

# Map Services Memory Limit
CYBERPOT_MAP_MEM_LIMIT_LOW=256m
CYBERPOT_MAP_MEM_LIMIT_STANDARD=512m
CYBERPOT_MAP_MEM_LIMIT_HIGH=1g

###################################################################################
# Disk Space Configuration
###################################################################################

# Log Retention Period (days)
# How long to keep logs before deletion
CYBERPOT_LOG_RETENTION_DAYS_LOW=14
CYBERPOT_LOG_RETENTION_DAYS_STANDARD=30
CYBERPOT_LOG_RETENTION_DAYS_HIGH=60

# Elasticsearch Index Lifecycle Management
# Hot phase duration (days) - actively written and searched
CYBERPOT_ES_ILM_HOT_DAYS_LOW=3
CYBERPOT_ES_ILM_HOT_DAYS_STANDARD=7
CYBERPOT_ES_ILM_HOT_DAYS_HIGH=14

# Warm phase duration (days) - read-only, compressed, less frequently searched
CYBERPOT_ES_ILM_WARM_DAYS_LOW=7
CYBERPOT_ES_ILM_WARM_DAYS_STANDARD=23
CYBERPOT_ES_ILM_WARM_DAYS_HIGH=46

# Log Compression
# Enable gzip compression for rotated logs
CYBERPOT_LOG_COMPRESSION=true

# Maximum log file size before rotation (MB)
CYBERPOT_LOG_MAX_SIZE_MB=100

###################################################################################
# Performance Configuration
###################################################################################

# Attack Map Update Interval (milliseconds)
# How frequently the attack map updates with new data
CYBERPOT_MAP_UPDATE_INTERVAL_LOW=5000
CYBERPOT_MAP_UPDATE_INTERVAL_STANDARD=2000
CYBERPOT_MAP_UPDATE_INTERVAL_HIGH=1000

# WebSocket Connection Limit
# Maximum concurrent WebSocket connections for real-time updates
CYBERPOT_WEBSOCKET_MAX_CONNECTIONS_LOW=10
CYBERPOT_WEBSOCKET_MAX_CONNECTIONS_STANDARD=50
CYBERPOT_WEBSOCKET_MAX_CONNECTIONS_HIGH=100

# Data Batch Size
# Number of events to batch before processing
CYBERPOT_BATCH_SIZE_LOW=100
CYBERPOT_BATCH_SIZE_STANDARD=50
CYBERPOT_BATCH_SIZE_HIGH=25

# Cache TTL (seconds)
# Time-to-live for cached responses
CYBERPOT_CACHE_TTL_LOW=300
CYBERPOT_CACHE_TTL_STANDARD=60
CYBERPOT_CACHE_TTL_HIGH=30

# Elasticsearch Query Timeout (seconds)
CYBERPOT_ES_QUERY_TIMEOUT_LOW=30
CYBERPOT_ES_QUERY_TIMEOUT_STANDARD=10
CYBERPOT_ES_QUERY_TIMEOUT_HIGH=5

###################################################################################
# Monitoring Configuration
###################################################################################

# Enable Resource Monitoring
# Collect and expose resource usage metrics
CYBERPOT_MONITORING_ENABLED=true

# Metrics Collection Interval (seconds)
CYBERPOT_METRICS_INTERVAL=15

# Alert Thresholds
# Memory usage alert threshold (percentage)
CYBERPOT_ALERT_MEMORY_THRESHOLD=90

# Disk usage alert threshold (percentage)
CYBERPOT_ALERT_DISK_THRESHOLD=85

# High I/O wait threshold (percentage)
CYBERPOT_ALERT_IOWAIT_THRESHOLD=50

###################################################################################
# Advanced Configuration
###################################################################################

# Elasticsearch Shard Configuration
# Number of primary shards per index
CYBERPOT_ES_SHARDS_LOW=1
CYBERPOT_ES_SHARDS_STANDARD=1
CYBERPOT_ES_SHARDS_HIGH=2

# Elasticsearch Replica Configuration
# Number of replica shards per index
CYBERPOT_ES_REPLICAS_LOW=0
CYBERPOT_ES_REPLICAS_STANDARD=0
CYBERPOT_ES_REPLICAS_HIGH=1

# Logstash Pipeline Workers
# Number of parallel pipeline workers
CYBERPOT_LS_WORKERS_LOW=2
CYBERPOT_LS_WORKERS_STANDARD=4
CYBERPOT_LS_WORKERS_HIGH=8

# Logstash Batch Size
# Number of events to collect before processing
CYBERPOT_LS_BATCH_SIZE_LOW=250
CYBERPOT_LS_BATCH_SIZE_STANDARD=125
CYBERPOT_LS_BATCH_SIZE_HIGH=50
